# Access log con el X-Request-Id que genera el frontend, para correlacionar con los logs del BFF.
log_format with_request_id '$remote_addr [$time_local] "$request" $status $body_bytes_sent '
                           '$request_time req_id=$http_x_request_id';

server {
  listen 8080;
  access_log /dev/stdout with_request_id;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Proxy al BFF en el mismo origen: la SPA llama a /api/* y no necesita CORS ni URLs fijas.
  location /api/ {
    proxy_pass ${BFF_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Los assets del build llevan hash en el nombre, así que se pueden cachear indefinidamente.
  location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Fallback de la SPA para que links directos como /pokemon/pikachu funcionen al recargar.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
}
