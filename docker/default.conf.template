server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;

  # Same-origin proxy to the BFF: the SPA calls /api/* and never needs CORS or a hardcoded URL.
  location /api/ {
    proxy_pass ${BFF_URL};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  # Hashed build assets can be cached forever.
  location ~* \.(?:js|css|woff2?|ico|png|svg)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # SPA fallback so deep links like /pokemon/pikachu work on reload.
  location / {
    add_header Cache-Control "no-cache";
    try_files $uri $uri/ /index.html;
  }

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;
}
